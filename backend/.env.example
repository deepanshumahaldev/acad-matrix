# ---------- App ----------
NODE_ENV=development
PORT=4000
LOG_LEVEL=info
# Comma-separated list of allowed browser origins (no wildcard)
FRONTEND_URL=http://localhost:5173

# ---------- Database (Neon) ----------
# Pooled connection (host contains "-pooler") — used by the running app
DATABASE_URL="postgresql://USER:PASSWORD@ep-xxxx-pooler.REGION.aws.neon.tech/AcadMatrix?sslmode=require&pgbouncer=true&connect_timeout=15"
# Direct connection — used only by `prisma migrate`
DIRECT_URL="postgresql://USER:PASSWORD@ep-xxxx.REGION.aws.neon.tech/AcadMatrix?sslmode=require"

# ---------- Auth ----------
# Generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=replace-with-at-least-32-random-characters
JWT_REFRESH_SECRET=replace-with-a-different-32-plus-character-string
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL_DAYS=7
MAX_LOGIN_ATTEMPTS=5
ACCOUNT_LOCK_MINUTES=15

# Refresh-token cookie. Same registrable domain for app + API (app.x.com / api.x.com): use lax.
# Different domains (x.vercel.app + y.onrender.com): use none (Secure is forced; Safari may still block it).
COOKIE_SAME_SITE=lax
COOKIE_DOMAIN=

# ---------- OTP ----------
OTP_TTL_MINUTES=5
OTP_MAX_ATTEMPTS=5
OTP_RESEND_COOLDOWN_SECONDS=60

# ---------- Email (Resend) — required in production ----------
RESEND_API_KEY=
EMAIL_FROM="AcadMatrix <no-reply@yourdomain.com>"

# ---------- File storage (Cloudflare R2 / S3) — required in production ----------
STORAGE_ENDPOINT=
STORAGE_REGION=auto
STORAGE_BUCKET=
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
MAX_UPLOAD_MB=10

# ---------- Rate limiting ----------
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
AUTH_RATE_LIMIT_MAX=10

# ---------- Seed (used by `npm run db:seed`) ----------
SEED_ADMIN_EMAIL=admin@AcadMatrix.local
SEED_ADMIN_PASSWORD=ChangeMe@123
SEED_DEFAULT_PASSWORD=Welcome@123
